#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q           &kp W       &kp E        &kp R        &kp T      &kp C_MUTE  &kp C_PP  &kp Y        &kp U            &kp I        &kp O            &kp P               &kp BACKSPACE
&kp LCTRL  &mt LEFT_GUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G      &kp LALT    &kp RALT  &kp H        &mt RSHIFT J     &mt RCTRL K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMI  &kp SQT
&kp LSHFT  &kp Z           &kp X       &kp C        &kp V        &kp B                            &kp N        &kp M            &kp COMMA    &kp DOT          &kp FSLH            &kp ESC
                                       &kp ESCAPE   &lt 4 SPACE  &lt 1 TAB                        &lt 2 ENTER  &lt 3 BACKSPACE  &kp DELETE
            >;
        };

        nav {
            bindings = <
&sys_reset  &trans    &trans    &trans     &trans     &trans  &trans  &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &msc SCRL_LEFT  &msc SCRL_RIGHT
&trans      &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &msc SCRL_DOWN  &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &kp K_UNDO      &kp K_REDO
&trans      &trans    &trans    &trans     &trans     &trans                          &kp HOME        &kp PG_DN       &kp PG_UP     &kp END          &kp INSERT      &kp PRINTSCREEN
                                &trans     &trans     &trans                          &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;
        };

        sym {
            bindings = <
&trans  &kp LEFT_BRACE  &kp AMPERSAND  &kp N8  &kp N9  &kp RBKT   &trans  &trans  &trans  &trans     &trans     &trans    &trans    &sys_reset
&trans  &kp LS(SEMI)    &kp LS(N4)     &kp N5  &kp N6  &kp EQUAL  &trans  &trans  &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
&trans  &kp LS(GRAVE)   &kp N1         &kp N2  &kp N3  &kp BSLH                   &trans  &trans     &trans     &trans    &trans    &trans
                                       &kp N9  &kp N0  &kp MINUS                  &trans  &trans     &trans
            >;
        };

        num {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans  &trans  &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &sys_reset
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans    &trans    &trans
                        &trans  &trans  &trans                  &trans  &trans     &trans
            >;
        };

        media {
            bindings = <
&sys_reset  &trans    &trans    &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans    &trans    &trans     &trans     &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans     &trans     &trans                  &trans  &trans  &trans
            >;
        };
    };
};
