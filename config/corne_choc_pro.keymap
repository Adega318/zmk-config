#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q       &kp W       &kp E        &kp R        &kp T      &kp LCTRL  &kp RCTRL  &kp Y        &kp U            &kp I        &kp O       &kp P          &kp BACKSPACE
&kp LCTRL  &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G      &kp LALT   &kp RALT   &kp H        &mt RSHIFT J     &mt RCTRL K  &mt RALT L  &mt RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V        &kp B                            &kp N        &kp M            &kp COMMA    &kp DOT     &kp FSLH       &kp ESC
                                   &kp ESC      &lt 4 SPACE  &lt 1 TAB                        &lt 2 ENTER  &lt 3 BACKSPACE  &kp DEL
            >;
        };

        nav {
            bindings = <
&sys_reset  &trans    &trans    &trans     &trans     &trans  &trans  &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &msc SCRL_LEFT  &msc SCRL_RIGHT
&trans      &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &msc SCRL_DOWN  &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &kp K_UNDO      &kp K_REDO
&trans      &trans    &trans    &trans     &trans     &trans                          &kp HOME        &kp PG_DN       &kp PG_UP     &kp END          &kp INSERT      &kp PRINTSCREEN
                                &trans     &trans     &trans                          &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;

            label = "nav";
        };

        sym {
            bindings = <
&trans  &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT  &trans  &trans  &trans  &trans     &trans     &trans    &trans    &sys_reset
&trans  &kp CARET  &kp AMPS   &kp LBKT  &kp RBKT  &kp EQUAL  &trans  &trans  &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
&trans  &kp STAR   &kp TILDE  &kp LPAR  &kp RPAR  &kp BSLH                   &trans  &trans     &trans     &trans    &trans    &trans
                              &kp LPAR  &kp RPAR  &kp MINUS                  &trans  &trans     &trans
            >;

            label = "sym";
        };

        num {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans  &trans  &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &sys_reset
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans    &trans    &trans
                        &trans  &mo 5   &trans                  &trans  &trans     &trans
            >;

            label = "num";
        };

        media {
            bindings = <
&sys_reset  &trans    &trans    &trans     &trans     &trans  &trans  &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &trans      &trans  &trans
&trans      &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &trans  &kp C_PREV       &kp C_VOL_DN     &kp C_VOL_UP     &kp C_NEXT  &trans  &trans
&trans      &trans    &trans    &trans     &trans     &trans                  &trans           &kp C_BRI_DN     &kp C_BRI_UP     &trans      &trans  &trans
                                &trans     &trans     &trans                  &kp C_PP         &mo 5            &kp C_MUTE
            >;

            label = "media";
        };

        fun {
            bindings = <
&trans  &kp F1  &kp F2      &kp F3       &kp F4          &kp F5  &trans  &trans  &kp F6      &kp F7        &kp F8        &kp F9        &kp F10       &kp F11
&trans  &trans  &sys_reset  &bootloader  &studio_unlock  &trans  &trans  &trans  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp F12
&trans  &trans  &trans      &trans       &trans          &trans                  &trans      &trans        &trans        &trans        &trans        &trans
                            &trans       &trans          &trans                  &trans      &trans        &trans
            >;

            label = "fun";
        };
    };
};
